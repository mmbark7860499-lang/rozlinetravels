# ==============================================================================
# SKY WAY TRAVELS TIRUR — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development, or add in Vercel Project Settings
# ==============================================================================

# Supabase Project URL & Anon Key (Get from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Keep private! Only used in server-side API routes & Admin actions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Travel Agency Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password
ADMIN_PASSCODE=your_admin_passcode

# Travel Boutique Online / Flight Supplier API (Optional - when API credentials provided)
TBO_API_ENDPOINT=https://api.travelboutiqueonline.com/v1
TBO_CLIENT_ID=
TBO_CLIENT_PASSWORD=
